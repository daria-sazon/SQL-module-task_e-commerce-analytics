-- Розрахунок основних метрик по аккаунтах (CTE 1)
WITH account_metrics AS (
 SELECT
 s.date AS event_date,
 sp.country,
 ac.send_interval, -- інтервал відправлення, встановлений акаунтом
 ac.is_verified, -- перевірено акаунт чи ні
 ac.is_unsubscribed, -- підписник відписався чи ні
 COUNT(DISTINCT acs.account_id) AS account_cnt,
 0 AS sent_msg,
 0 AS open_msg,
 0 AS visit_msg
 FROM `DA.session` s
 JOIN `DA.session_params` sp ON s.ga_session_id = sp.ga_session_id
 JOIN `DA.account_session` acs ON sp.ga_session_id = acs.ga_session_id
 JOIN `DA.account` ac ON acs.account_id = ac.id
 GROUP BY event_date, sp.country, ac.send_interval, ac.is_verified, ac.is_unsubscribed
),


-- Розрахунок основних метрик по емейлах (CTE 2)
email_metrics AS (
 SELECT
 DATE_ADD (s.date, INTERVAL es.sent_date DAY) AS event_date,
 sp.country,
 ac.send_interval,
 ac.is_verified,
 ac.is_unsubscribed,
 0 AS account_cnt,
 COUNT(DISTINCT es.id_message) AS sent_msg,
 COUNT(DISTINCT eo.id_message) AS open_msg,
 COUNT(DISTINCT ev.id_message) AS visit_msg
 FROM `DA.session` s
 JOIN `DA.session_params` sp ON s.ga_session_id = sp.ga_session_id
 JOIN `DA.account_session` acs ON sp.ga_session_id = acs.ga_session_id
 JOIN `DA.account` ac ON acs.account_id = ac.id
 LEFT JOIN `DA.email_sent` es ON acs.account_id = es.id_account
 LEFT JOIN `DA.email_open` eo ON es.id_message = eo.id_message
 LEFT JOIN `DA.email_visit` ev ON eo.id_message = ev.id_message
 GROUP BY event_date, sp.country, ac.send_interval, ac.is_verified, ac.is_unsubscribed
),


-- Об’єднання метрик по аккаунтах та емейлах (СТЕ 3)
union_metrics AS (
 SELECT * FROM account_metrics
 UNION ALL
 SELECT * FROM email_metrics
),


-- Розрахунок додаткових метрик по країнах (CTE 4)
country_metrics AS (
 SELECT
 event_date,
 country,
 send_interval,
 is_verified,
 is_unsubscribed,
 SUM(account_cnt) AS account_cnt,
 SUM(sent_msg) AS sent_msg,
 SUM(open_msg) AS open_msg,
 SUM(visit_msg) AS visit_msg
 FROM union_metrics
 GROUP BY event_date, country, send_interval, is_verified, is_unsubscribed
),


-- Розрахунок загальних показників (кількість створених підписників та відправлених листів в цілому по країнах (CTE 5))
total_metrics AS (
 SELECT
 event_date,
 country,
 send_interval,
 is_verified,
 is_unsubscribed,
 account_cnt,
 sent_msg,
 open_msg,
 visit_msg,
 SUM(account_cnt) OVER (PARTITION BY country) AS total_country_account_cnt,
 SUM(sent_msg) OVER (PARTITION BY country) AS total_country_sent_cnt
 FROM country_metrics
),


-- Розрахунок рейтингу країн за кількістю створених підписників та відправлених листів в цілому (СТЕ 6)
rank_country AS (
 SELECT
 event_date,
 country,
 send_interval,
 is_verified,
 is_unsubscribed,
 account_cnt,
 sent_msg,
 open_msg,
 visit_msg,
 total_country_account_cnt,
 total_country_sent_cnt,
 DENSE_RANK() OVER (ORDER BY total_country_account_cnt DESC) AS rank_total_country_account_cnt,
 DENSE_RANK() OVER (ORDER BY total_country_sent_cnt DESC) AS rank_total_country_sent_cnt
 FROM total_metrics
 )


-- Фінальний запит за кількістю підписників та відправлених листів
SELECT
 event_date as date,
 country,
 send_interval,
 is_verified,
 is_unsubscribed,
 account_cnt,
 sent_msg,
 open_msg,
 visit_msg,
 total_country_account_cnt,
 total_country_sent_cnt,
 rank_total_country_account_cnt,
 rank_total_country_sent_cnt
FROM rank_country
WHERE rank_total_country_account_cnt <= 10 
OR rank_total_country_sent_cnt <= 10
